# Application URLs used by future cross-app links.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_SPECIALIST_URL=http://localhost:3002

# Supabase public configuration. Copy these placeholders into each Next.js
# application's .env.local file when that application starts using Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only placeholder for future trusted operations. Never prefix this with
# NEXT_PUBLIC_ and never expose it to browser or mobile bundles.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Shared secret used by the admin app's CMS publish/unpublish server actions to
# call apps/web's /api/revalidate webhook. Same value in both apps' .env.local;
# never prefix with NEXT_PUBLIC_. Generate with `openssl rand -hex 32` or similar.
CMS_REVALIDATE_SECRET=

# Optional local-only credentials for authenticated Playwright auth scenarios.
# Never commit real values; provide them through the shell or a gitignored env file.
E2E_ANNA_EMAIL=
E2E_ANNA_PASSWORD=

# Stripe (online booking payments, apps/web only). Use sandbox keys locally.
# The secret key and webhook secret are server-only: never prefix them with
# NEXT_PUBLIC_. The webhook secret comes from `stripe listen` locally, or from
# the webhook endpoint in the Stripe Dashboard in deployed environments.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# Cloudflare Turnstile (apps/web, online booking). Without them, development
# uses Cloudflare's always-passing test keys; production refuses to start a
# booking. The secret key is server-only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# E-mail (apps/web, booking confirmations) through Resend. The API key is
# server-only. EMAIL_FROM is the sender: onboarding@resend.dev until the
# site's domain is verified in Resend (which then only delivers to the
# Resend account's own address), afterwards e.g.
# "Kolor Sensu <rezerwacje@kolorsensu.pl>".
RESEND_API_KEY=
EMAIL_FROM=

# The database (pg_cron + pg_net, migration payment_schedule) calls
# /api/cron/platnosci every 15 minutes with this secret: it sends the
# payment and visit reminders. Server-only; any long random string. The
# same value goes to Supabase Vault as 'cron_secret', with the site's
# address as 'site_url'.
CRON_SECRET=
