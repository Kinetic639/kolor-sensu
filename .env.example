# Kolor Sensu: every environment variable, which app needs it, where it
# comes from, and where to set it.
#
# Where to set them
#   Locally:    each app's own apps/<app>/.env.local (gitignored). Copy the
#               lines marked for that app. The root .env.local is read only by
#               Playwright (the E2E_* lines).
#   Production: Vercel, one project per app (web, admin, specialist):
#               Project → Settings → Environment Variables, "Production"
#               (and "Preview" if previews should work). Redeploy after a
#               change: Next.js reads NEXT_PUBLIC_* at build time.
#   Database:   the two Supabase Vault secrets at the end of this file are
#               not environment variables: they are set once per Supabase
#               project, in the SQL editor.
#
# Never prefix a secret with NEXT_PUBLIC_: those values go to the browser.
# Apps: web = apps/web (the public site, bookings, payments, e-mails),
#       admin = apps/admin, specialist = apps/specialist.

# ---------------------------------------------------------------------------
# Addresses of the three apps                         apps: web, admin, specialist
# ---------------------------------------------------------------------------
# Used for links between the apps, links in e-mails and Stripe's return page,
# and by the portals to call the site's API (bookings, cancellations, refunds).
# Locally the defaults below; in production the real domains, without a
# trailing slash, e.g. https://kolorsensu.pl, https://admin.kolorsensu.pl,
# https://specjalista.kolorsensu.pl. Set ALL THREE in ALL THREE apps.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_SPECIALIST_URL=http://localhost:3002

# ---------------------------------------------------------------------------
# Supabase                                            apps: web, admin, specialist
# ---------------------------------------------------------------------------
# From: Supabase Dashboard → the project → Project Settings → API Keys
# (the project URL is under Project Settings → Data API). Use the DEV project
# locally and the production project in production.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# app: web only. The secret key (Project Settings → API Keys → Secret keys).
# Bypasses row-level security: bookings, payments and e-mails use it on the
# server. Server-only.
SUPABASE_SECRET_KEY=sb_secret_your_key

# ---------------------------------------------------------------------------
# CMS revalidation                                    apps: web, admin
# ---------------------------------------------------------------------------
# The admin portal's publish/unpublish calls the site's /api/revalidate with
# this shared secret. Any long random string (e.g. `openssl rand -hex 32`);
# the SAME value in web and admin. Server-only.
CMS_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# CMS preview (drafts on the site)                    apps: web, admin
# ---------------------------------------------------------------------------
# The CMS's "Podgląd" opens the site with the unpublished drafts: the admin
# portal signs a short-lived link with this secret and the site's
# /api/preview checks it. Any long random string (e.g. `openssl rand -hex
# 32`), DIFFERENT from CMS_REVALIDATE_SECRET; the SAME value in web and admin.
# Server-only. Without it "Podgląd" says the preview is not configured.
# The site reads the drafts with SUPABASE_SECRET_KEY (above), on its server.
CMS_PREVIEW_SECRET=

# ---------------------------------------------------------------------------
# Stripe (online payments)                            app: web only
# ---------------------------------------------------------------------------
# From: Stripe Dashboard → Developers → API keys. Locally the sandbox ("test")
# keys (pk_test_…, sk_test_…); in production the live keys (pk_live_…,
# sk_live_…) after the account is verified, with BLIK and Przelewy24 turned on
# in Settings → Payment methods.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
# The webhook's signing secret (whsec_…).
#   Locally: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
#   Production: Stripe Dashboard → Developers → Webhooks → Add endpoint
#   https://<web domain>/api/stripe/webhook with the events
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.async_payment_failed, checkout.session.expired,
#   charge.refunded; then "Signing secret" → Reveal.
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (bot check in the booking wizard)   app: web only
# ---------------------------------------------------------------------------
# From: Cloudflare Dashboard → Turnstile → Add widget (domain: the site's
# domain, mode: Managed) → Site Key and Secret Key. Locally they may stay
# empty: development uses Cloudflare's always-passing test keys. In
# production they are required: without them the wizard refuses to hold a
# time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# E-mail through Resend                               app: web only
# ---------------------------------------------------------------------------
# From: resend.com → API Keys → Create API key (permission: Sending access).
# Server-only.
RESEND_API_KEY=
# The sender. Until the domain is verified in Resend (Domains → Add domain,
# then the SPF and DKIM records in the DNS of kolorsensu.pl): leave
# "onboarding@resend.dev", which delivers only to the Resend account's own
# address. Afterwards e.g. "Kolor Sensu <rezerwacje@kolorsensu.pl>".
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Scheduled payment jobs                              app: web only (+ Vault)
# ---------------------------------------------------------------------------
# The database (pg_cron + pg_net, migration payment_schedule) calls
# https://<web domain>/api/cron/platnosci every 15 minutes with
# "Authorization: Bearer <CRON_SECRET>": it sends the payment reminders,
# the cancellations for want of payment and the visit reminders (the
# cancelling itself runs in the database every 5 minutes, needing nothing).
# Any long random string; server-only. Locally optional: the database cannot
# reach localhost, so call the route by hand to test it.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Supabase Vault (NOT environment variables)          the Supabase project
# ---------------------------------------------------------------------------
# Set once per Supabase project (production; DEV only if it should send the
# reminders), in Supabase Dashboard → SQL Editor:
#
#   select vault.create_secret('https://kolorsensu.pl', 'site_url');
#   select vault.create_secret('<the same value as CRON_SECRET>', 'cron_secret');
#
# To change one later:
#   select vault.update_secret(
#     (select id from vault.secrets where name = 'cron_secret'), '<new value>');
# Without them the e-mail call is skipped; nothing else breaks.

# ---------------------------------------------------------------------------
# Supabase Auth redirects (NOT environment variables)  the Supabase project
# ---------------------------------------------------------------------------
# The portals' "forgot password" e-mails link back to
# <portal>/auth/callback. Supabase only allows listed addresses:
# Authentication → URL Configuration → Redirect URLs, add
#   https://admin.kolorsensu.pl/auth/callback
#   https://specjalista.kolorsensu.pl/auth/callback
# (locally http://localhost:3001/auth/callback and
# http://localhost:3002/auth/callback), and set Site URL to the web domain.

# ---------------------------------------------------------------------------
# End-to-end tests (Playwright)                       root .env.local only
# ---------------------------------------------------------------------------
# Accounts on the DEV project used by tests/e2e. Never commit real values.
E2E_ANNA_EMAIL=
E2E_ANNA_PASSWORD=
E2E_SPECIALIST_EMAIL=
E2E_SPECIALIST_PASSWORD=
E2E_UNPUBLISHED_SPECIALIST_SLUG=
