{
  "name": "@kolor-sensu/storybook",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build --output-dir storybook-static",
    "test-storybook": "vitest run --project=storybook",
    "test-storybook:watch": "vitest --project=storybook",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/design-system": "workspace:*",
    "@repo/ui": "workspace:*",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@repo/config": "workspace:*",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-mcp": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "10.10.0",
    "playwright": "^1.63.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
